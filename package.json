{
  "name": "eidolon",
  "version": "1.0.0",
  "private": true,
  "description": "EIDOLON — The Museum of Impossible Things. A 90-second surreal film made entirely with procedural Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/render.mjs --stills",
    "render:preview": "node scripts/render.mjs --scale 0.5 --step 2 --out output/eidolon_preview.mp4",
    "render": "node scripts/render.mjs --out output/eidolon_final.mp4",
    "contact": "node scripts/contact.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
